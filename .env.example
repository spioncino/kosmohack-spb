# Скопируйте в .env и заполните. Файл .env в .gitignore, в репозиторий не попадёт.
SPACETRACK_USER=you@example.com
SPACETRACK_PASS=your-password

# Docker (deploy/compose.yml). Пароль Postgres для сервиса db; символ $ в пароле удваивается ($$).
POSTGRES_PASSWORD=change-me
# Домен для Caddy. localhost даёт HTTP без TLS на порту 80; настоящий домен даёт автоматический TLS от Let's Encrypt.
# Сервер без домена: DOMAIN=http://<IP сервера> даёт HTTP по IP без TLS (docs/DEPLOY.md).
DOMAIN=localhost

# Подключение к базе. В compose задаётся автоматически из POSTGRES_PASSWORD
# (postgresql+psycopg://evarisk:<POSTGRES_PASSWORD>@db:5432/evarisk) и перекрывает значение отсюда.
# Строка ниже нужна только для запуска без Docker; без неё используется sqlite:///data/evarisk.db.
# EVARISK_DATABASE_URL=sqlite:///data/evarisk.db

# Докачка архива по запросу (D59): задание расчёта на период, которого нет в хранилище, само скачивает открытые
# архивы в зеркало и импортирует их. В сеть ходит только воркер. Значения ниже действуют по умолчанию.
# EVARISK_ARCHIVE_BACKFILL=true
# EVARISK_MIRROR_ROOT=data/mirror

# Публичный туннель Cloudflare. При true (по умолчанию) запросы с заголовками cf-connecting-ip или cf-ray не
# меняют состояние источников: POST /sources/{name}/state и POST /sources/{name}/refresh отвечают 403
# tunnel_readonly. С самой машины сервиса эти ручки работают. Тело запроса больше 262144 байт отвергается
# с 413 независимо от настройки.
# EVARISK_TUNNEL_READONLY=true

# Каталог сборки фронтенда (frontend/dist после make front или стадии frontend в Dockerfile): api раздаёт его с «/»,
# старую страницу web/ с «/dev»; без каталога web/ раздаётся с «/».
# EVARISK_FRONTEND_DIST=frontend/dist

# Языковая модель для сводки для экипажа: Qwen через Cloud.ru Evolution, совместимый с OpenAI (D58).
# Ключи можно держать в отдельном файле .env.llm; без них сводка отвечает шаблонным текстом, это штатное
# состояние, а не ошибка. Модель только формулирует: числа и времена сверяются с фактами расчёта.
QWEN_BASE_URL=
QWEN_KEY_ID=
QWEN_SECRET=
# Имя развёртывания модели в API; пусто значит значение по умолчанию из briefing/llm.py.
# QWEN_MODEL=<имя развёртывания>
# Повторы вызова модели при временном сбое (сеть, таймаут, 429, 5xx) с паузой от 0.5 до 4 с; по умолчанию 5.
# QWEN_RETRIES=5

# Служба синтеза речи для озвучки сводки (каталог tts/, документирована там). Без переменной сервер звук не
# отдаёт и озвучка остаётся на стороне браузера.
# На машине разработки: http://localhost:8010 (scripts/dev_server.sh tts-start). В Docker переменную ставит
# deploy/compose.voice.yml (EVARISK_TTS_URL=http://tts:8010), который подключает make up-voice; в .env её задавать
# не нужно: при запуске без профиля voice сервиса tts нет и обращаться к нему не к чему.
# EVARISK_TTS_URL=http://localhost:8010
